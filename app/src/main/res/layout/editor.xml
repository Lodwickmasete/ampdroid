<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1E">

    <!-- ═══════════════════════════════════════════════════════════
         FILE BROWSER
    ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/fileBrowserLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#242428"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_folder"
                android:layout_marginRight="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Files"
                android:textColor="#E0E0E0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNewFile"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="New File"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:background="@drawable/button_secondary"
                android:drawableLeft="@drawable/ic_add"
                android:drawablePadding="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginRight="4dp" />

            <!-- btnSave hidden in browser mode — shown in editor -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Save"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:background="@drawable/button_secondary"
                android:drawableLeft="@drawable/ic_save"
                android:drawablePadding="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333338" />

        <!-- File list -->
        <ListView
            android:id="@+id/fileListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A1A1E"
            android:divider="#2A2A2E"
            android:dividerHeight="1dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scrollbars="vertical" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         EDITOR
    ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/editorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Editor toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#242428"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Undo"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:background="@drawable/bg_control_btn"
                android:drawableLeft="@drawable/ic_undo"
                android:drawablePadding="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnRedo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Redo"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:background="@drawable/bg_control_btn"
                android:drawableLeft="@drawable/ic_redo"
                android:drawablePadding="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Save"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:background="@drawable/button_secondary"
                android:drawableLeft="@drawable/ic_save"
                android:drawablePadding="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />
        </LinearLayout>

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="#1E1E22"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:hint="Search…"
                android:textColorHint="#555560"
                android:textColor="#C8C8D0"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnSearchPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="◀"
                android:textSize="14sp"
                android:textColor="#B0B0C0"
                android:background="@drawable/bg_control_btn"
                android:padding="0dp"
                android:layout_marginRight="2dp" />

            <Button
                android:id="@+id/btnSearchNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="▶"
                android:textSize="14sp"
                android:textColor="#B0B0C0"
                android:background="@drawable/bg_control_btn"
                android:padding="0dp" />
        </LinearLayout>

        <!-- File info strip -->
        <TextView
            android:id="@+id/fileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="10sp"
            android:textColor="#555565"
            android:background="#16161A"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A30" />

        <!-- Code editor -->
        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1A1A1E"
            android:textColor="#D4D4DC"
            android:textColorHint="#444450"
            android:textSize="13sp"
            android:typeface="monospace"
            android:gravity="top|left"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="10dp"
            android:scrollbars="vertical|horizontal"
            android:overScrollMode="never"
            android:textIsSelectable="true"
            android:cursorVisible="true" />

        <!-- HTML preview bottom bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E22"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preview"
                android:textColor="#666676"
                android:textSize="12sp"
                android:layout_marginRight="8dp" />

            <ImageButton
                android:id="@+id/btnPlayPreview"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_control_btn"
                android:scaleType="center"
                android:contentDescription="Preview HTML" />
        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         WEBVIEW OVERLAY
    ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/webViewLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- WebView toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#242428"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnCloseWebView"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Close"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:background="@drawable/bg_control_btn"
                android:drawableLeft="@drawable/ic_close"
                android:drawablePadding="4dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_web"
                android:layout_marginRight="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Web Preview"
                android:textColor="#909098"
                android:textSize="13sp" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Progress bar (floating, centered) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>